@model IEnumerable<QuizViewModel.ViewModels.CouponViewModel>


<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.CouponId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CouponCode)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CouponCategory)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CouponExpiryDate)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CouponId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CouponCode)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CouponCategory)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CouponExpiryDate)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { couponId=item.CouponId }) |
            @Html.ActionLink("Delete", "Delete", new { couponId = item.CouponId })
        </td>
    </tr>
}

</table>
